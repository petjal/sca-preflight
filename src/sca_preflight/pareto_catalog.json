      "vulnerable_version_regex": "^2\\.(?:[0-9]|1[0-6]|17\\.0)(?:$|[^0-9])",
      "severity": "CRITICAL",
      "description": "Log4Shell vulnerable JndiLookup class present in archive."
    },
    {
      "id": "CVE-2024-3094",
